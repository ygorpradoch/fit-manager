<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_background"
    android:orientation="vertical"
    tools:context=".MontarTreinoActivity">

    <LinearLayout
        android:id="@+id/headerMontarTreino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fm_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Montar Treino"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtAluno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fm_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nome do treino"
                android:textColor="@color/fm_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNomeTreino"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:autofillHints="none"
                android:background="@drawable/bg_input"
                android:hint="Ex.: Treino A - Peito/Tríceps"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/fm_text"
                android:textColorHint="@color/fm_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tipo"
                android:textColor="@color/fm_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTipo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_spinner"
                android:paddingStart="10dp"
                android:paddingEnd="44dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Dias da semana"
                android:textColor="@color/fm_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spDias"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_spinner"
                android:paddingStart="10dp"
                android:paddingEnd="44dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Exercícios"
                android:textColor="@color/fm_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerExerciciosForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdicionarExercicio"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="+ Adicionar Exercício"
                android:textColor="@color/fm_blue"
                app:cornerRadius="14dp"
                app:strokeColor="@color/fm_blue" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelarTreino"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textColor="@color/fm_blue"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/fm_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvarTreino"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Salvar"
                    app:backgroundTint="@color/fm_blue"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
