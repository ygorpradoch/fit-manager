<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LinhaExercicio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
    <style name="NomeExercicio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/fm_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="CargaExercicio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/fm_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="DivisorLinha">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/fm_divider</item>
    </style>
    <!-- Deixa o botão flutuante redondo -->
    <style name="FabCircular" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>